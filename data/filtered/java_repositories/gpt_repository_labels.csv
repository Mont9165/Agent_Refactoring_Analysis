```java
// Otomatik ID assignment (hash-based)
if (customModelData > 0) {
    meta.setCustomModelData(customModelData);
} else {
    int autoId = Math.abs(id.hashCode()) % 10000 + 1000;
    meta.setCustomModelData(autoId);
    customModelData = autoId;
