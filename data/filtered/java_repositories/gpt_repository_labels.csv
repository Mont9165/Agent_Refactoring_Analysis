        ""zone_type"": ""Urbano"",
        ""settlement_type"": ""Colonia""
      }
    ],
    ""municipality"": ""Cuautitlán Izcalli""
  },
  {
    ""zip_code"": ""54720"",
    ""locality"": ""Cuautitlán Izcalli"",
    ""federal_entity"": ""Estado de México"",
    ""settlements"": [
      {
        ""name"": ""Residencial Las Águilas"",
        ""zone_type"": ""Urbano"",
