controls.up=UP
controls.down=DOWN
controls.left=LEFT
controls.right=RIGHT
controls.pause=ESCAPE"
Hunter-Boone/discord-bot-java,Hunter-Boone,discord-bot-java,1,0,"Repository: Hunter-Boone/discord-bot-java
